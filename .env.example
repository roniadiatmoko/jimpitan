# ==============================================================
# JIMPITAN V2 - FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Salin file ini menjadi `.env` jika ingin mengubah konfigurasi frontend.
# ==============================================================

# Port server frontend saat pengembangan (default: 3001)
PORT=3001

# URL Endpoint Backend API
# - Untuk lokal / pengembangan: http://localhost:3000
# - Untuk produksi / Cloudflare: https://api-jimpitan.roniadiatmoko.my.id
REACT_APP_API_URL=http://localhost:3000

# Nonaktifkan pembuatan source map saat build untuk memperkecil ukuran bundle dan mengamankan kode
GENERATE_SOURCEMAP=false

# Mencegah browser otomatis terbuka saat 'npm start'
BROWSER=none

# Kunci rahasia API untuk verifikasi request transaksi ke backend (opsional, default: rahasiakita123)
# REACT_APP_API_SECRET_KEY=rahasiakita123
